# Virtual environments
venv/
.venv/
env/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local databases and secrets
*.db
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Git and IDE
.git/
.gitignore
.idea/
.vscode/

# Build artifacts
build/
dist/
*.egg-info/

# Uploads directory (container creates it, don't copy local uploads)
static/uploads/*
!static/uploads/.gitkeep
