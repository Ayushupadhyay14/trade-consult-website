# ==========================================
# Trade Consult Environment Configuration
# ==========================================

# --- Core App Settings ---
PROJECT_NAME="AlphaInsiight API"
SECRET_KEY="generate-a-strong-random-key-here-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000
WORKERS=2
RUN_SEED=true

# --- Database (PostgreSQL for Docker / Production) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=trade_consult
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_password@db:5432/trade_consult

# --- Redis Cache / Broker ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- CORS (Comma-separated frontend URLs) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,https://alphainsiight.com,https://www.alphainsiight.com

# --- Admin Initial Credentials ---
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@alphainsiight.com
ADMIN_PASSWORD=change-me-to-a-very-strong-admin-password

# --- SMS Gateway (MSG91) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# --- WhatsApp Business API ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
